# Outlook MCP Environment Configuration
# Copy this file to .env and fill in your actual values

# Azure AD Application Registration
OUTLOOK_CLIENT_ID="your-client-id-here"
OUTLOOK_CLIENT_SECRET="your-client-secret-here"
OUTLOOK_TENANT_ID="your-tenant-id-here"
MS_TENANT_ID=""

# Optional: Tenant ID for institutional/organizational accounts.
# Leave empty for personal Microsoft accounts (uses /common endpoint).

# Note: Never commit your actual .env file to version control
# The .env file is already in .gitignore for security
