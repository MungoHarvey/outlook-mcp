# Microsoft Azure app registration credentials
# Copy this file to .env and fill in your values:
#   cp outlook-skills/.env.example outlook-skills/.env   (macOS/Linux)
#   Copy-Item outlook-skills\.env.example outlook-skills\.env   (Windows)
#
# Get these from: https://portal.azure.com > App registrations > your app > Overview

OUTLOOK_TENANT_ID=common
OUTLOOK_CLIENT_ID=your-application-client-id-here
OUTLOOK_CLIENT_SECRET=your-client-secret-here

# OUTLOOK_TENANT_ID notes:
#   common          — personal Microsoft accounts + any work/school tenant
#   organizations   — work/school accounts only
#   <tenant-guid>   — restrict to a specific Azure AD tenant
