# ============================================================
# Outlook MCP Skills — .gitignore
# ============================================================

# --- Credentials & Tokens (CRITICAL — never commit) ---
outlook-skills/.env
outlook-skills/tokens.json
outlook-skills/config.json
*.pem
*.key
*.cert

# --- Node.js ---
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Python ---
__pycache__/
*.pyc
*.pyo
outlook-skills/.venv/

# --- Build artefacts ---
*.plugin
outlook-skills.zip
outlook-skills-*.zip

# --- Editor / IDE ---
.idea/
.vscode/
.cursor/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db

# --- Claude Code local state ---
# These are session-specific and should not be shared
.claude/settings.local.json
.claude/state/
.claude/loop-complete.json

# --- Skill eval workspaces (may contain personal data) ---
skills/*-workspace/
*_raw.json

# --- Setup source assets ---
setup/AzureGuide.pptx
setup/~$*

# --- Logs ---
logs/
*.log

# --- MCP server dependencies ---
mcp-server/node_modules/
mcp-server/package-lock.json

# --- Temporary / development debris ---
New folder/
outlook-skills/outlook-skills-zip/
loop-complete.json
