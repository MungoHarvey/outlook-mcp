# ============================================================
# Outlook MCP Skills — .gitignore
# ============================================================

# --- Credentials & Tokens (CRITICAL — never commit) ---
# Class patterns: cover .env at any location and every backup/temp variant
# (.env.bak, .env.old, .env.backup, tokens.json.tmp, ...)
.env
.env.*
!.env.example
tokens.json*
outlook-skills/config.json
*.pem
*.key
*.cert

# --- Node.js ---
# package-lock.json is intentionally tracked (reproducible npm test/install)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Python ---
__pycache__/
*.pyc
*.pyo
outlook-skills/.venv/

# --- Build artefacts ---
*.plugin
outlook-skills.zip
outlook-skills-*.zip

# --- Editor / IDE ---
.idea/
.vscode/
.cursor/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db

# --- Claude Code local state ---
# These are session-specific and should not be shared
.claude/settings.local.json
.claude/state/

# --- Skill eval workspaces (may contain personal data) ---
skills/*-workspace/
*_raw.json

# --- Setup source assets ---
setup/AzureGuide.pptx
setup/~$*

# --- Logs ---
logs/
*.log

# --- MCP server dependencies ---
mcp-server/node_modules/

# --- Temporary / development debris ---
New folder/
outlook-skills/outlook-skills-zip/
loop-complete*.json
